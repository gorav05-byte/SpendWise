# Copy this file to ".env" (optional - SpendWise creates one for you on first start).
# Port the app listens on
PORT=3000

# Secret used to sign login tokens (JWT). Use a long random string.
# If this is missing, SpendWise generates a random one and saves it to .env automatically.
JWT_SECRET=change_this_to_a_long_random_string

# development | production  (production makes the login cookie "secure", i.e. HTTPS only)
NODE_ENV=development

# SQLite database file location (relative to the project folder)
DB_PATH=database/spendwise.db
